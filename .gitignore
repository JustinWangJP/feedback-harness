# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Node(検査ツールの実体。package.json / package-lock.json だけを共有する)
node_modules/

# Lint / test caches
.ruff_cache/
.mypy_cache/
.pytest_cache/
.coverage

# Claude Code local-only state (personal, not shared)
.claude/settings.local.json

# Harness working area (QAレポート等の中間生成物 — 共有資産ではない)
_workspace/

# Stop フックの検査スタンプ(mtime比較用のローカル状態。共有すると他マシンの
# 時刻で「検査済み」と誤判定されうる)
.feedback/.last-check

# フック合否のイベントログ(stats用。マシン固有のノイズが混ざるため共有しない)
.feedback/events.jsonl

# レポートの基点スタンプ(振り返り実施日。個人の運用リズムなので共有しない)
.feedback/.last-retro

# 脆弱性監査の最終実行日(audit.sh が成功時に書く。マシンローカル)
.feedback/.last-audit

# feedback CLI のrepository-wide lockと中断transaction journal。
# lockはinodeを共有し続けるため意図的に残し、journalは次回CLI実行で回復・削除する。
.feedback/.state.lock
.feedback/.transaction.json

# 個人設定レイヤ(この端末だけの設定。共有設定 config.yaml に勝つ)。
# 手元の事情(ツール未導入・重い検査の一時停止)を、チームの設定を
# 書き換えずに反映するためのもの
.feedback/local/

# OS
.DS_Store
